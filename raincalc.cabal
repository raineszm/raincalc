-- Initial raincalc.cabal generated by cabal init.  For further
-- documentation, see http://haskell.org/cabal/users-guide/

name:                raincalc
version:             0.1.0.0
synopsis:            A simple rpn calculator in Haskell.
-- description:
license:             GPL-3
license-file:        LICENSE
author:              Zach Raines
maintainer:          raineszm+raincalc@gmail.com
-- copyright:
category:            Math
build-type:          Simple
cabal-version:       >=1.8

executable raincalc
  main-is:         Main.hs
  hs-source-dirs:  src/
  extensions:          TupleSections
  build-depends:     base == 4.*, containers, haskeline, mtl == 2.1.2, transformers == 0.3.0.0, regex-pcre

library
  hs-source-dirs:  src/
  exposed-modules:
    Math.RainCalc.Classes
    , Math.RainCalc.Command
    , Math.RainCalc.Modifier
    , Math.RainCalc.Numbers
    , Math.RainCalc.Operator
    , Math.RainCalc.Registers
    , Math.RainCalc.RPNState
    , Math.RainCalc.Utils
  extensions:          TupleSections
  build-depends:     base == 4.*, containers, haskeline, mtl == 2.1.2, transformers == 0.3.0.0, regex-pcre

test-suite spec
  type:
    exitcode-stdio-1.0
  ghc-options:
    -Wall -Werror
  hs-source-dirs:
    test
  main-is:
    Spec.hs
  build-depends:
    base    == 4.*
    , mtl
    , hspec   >= 1.3
    , QuickCheck >= 2.0
    , raincalc
